<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Менеджер задач</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="container">
    <header>
        <h1>Менеджер задач</h1>
        <div class="stats">
            <span class="stat-item total">Всего: <strong><%= stats.total %></strong></span>
            <span class="stat-item pending">Ожидают: <strong><%= stats.pending %></strong></span>
            <span class="stat-item in-progress">В работе: <strong><%= stats.inProgress %></strong></span>
            <span class="stat-item completed">Выполнено: <strong><%= stats.completed %></strong></span>
        </div>
    </header>

    <div class="task-form-container">
        <h2>Новая задача</h2>
        <form action="/tasks" method="POST" enctype="multipart/form-data" class="task-form">
            <div class="form-group">
                <input type="text" name="title" placeholder="Название задачи" required>
            </div>
            <div class="form-group">
                <textarea name="description" placeholder="Описание задачи" rows="2"></textarea>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <select name="status">
                        <option value="pending">Ожидает</option>
                        <option value="in-progress">В работе</option>
                        <option value="completed">Выполнено</option>
                    </select>
                </div>
                <div class="form-group">
                    <input type="date" name="dueDate">
                </div>
            </div>
            <div class="form-group">
                <label>Прикрепить файл:</label>
                <input type="file" name="file">
            </div>
            <button type="submit" class="btn btn-primary">Добавить задачу</button>
        </form>
    </div>

    <div class="filter-container">
        <span>Фильтр:</span>
        <a href="/?filter=all" class="filter-btn <%= filter === 'all' ? 'active' : '' %>">Все</a>
        <a href="/?filter=pending" class="filter-btn <%= filter === 'pending' ? 'active' : '' %>">Ожидают</a>
        <a href="/?filter=in-progress" class="filter-btn <%= filter === 'in-progress' ? 'active' : '' %>">В работе</a>
        <a href="/?filter=completed" class="filter-btn <%= filter === 'completed' ? 'active' : '' %>">Выполнено</a>
    </div>

    <div class="tasks-container">
        <% if (tasks.length === 0) { %>
            <div class="empty-state"><p>Нет задач</p></div>
        <% } else { %>
            <% tasks.forEach(task => { %>
                <div class="task-card status-<%= task.status %>">
                    <div class="task-header">
                        <h3><%= task.title %></h3>
                        <span class="status-badge status-<%= task.status %>">
                                <%= task.status === 'pending' ? 'Ожидает' :
                                        task.status === 'in-progress' ? 'В работе' : 'Выполнено' %>
                            </span>
                    </div>

                    <% if (task.description) { %>
                        <p class="task-description"><%= task.description %></p>
                    <% } %>

                    <% if (task.dueDate) { %>
                        <div class="task-due-date">Срок: <%= new Date(task.dueDate).toLocaleDateString('ru-RU') %></div>
                    <% } %>

                    <% if (task.files && task.files.length > 0) { %>
                        <div class="task-files">
                            <strong>Прикрепленные файлы:</strong>
                            <ul>
                                <% task.files.forEach((file, index) => { %>
                                    <li>
                                        📎 <%= file.originalName %>
                                        <span class="file-size">(<%= Math.round(file.size / 1024) %> КБ)</span>
                                        <form action="/tasks/<%= task.id %>/files/<%= index %>/delete" method="POST" style="display: inline;">
                                            <button type="submit" class="btn btn-sm btn-danger">✕</button>
                                        </form>
                                    </li>
                                <% }) %>
                            </ul>
                        </div>
                    <% } %>

                    <div class="task-actions">
                        <form action="/tasks/<%= task.id %>/files" method="POST" enctype="multipart/form-data" class="file-upload-form">
                            <input type="file" name="file" required>
                            <button type="submit" class="btn btn-sm btn-secondary">📎 Прикрепить</button>
                        </form>

                        <form action="/tasks/<%= task.id %>" method="POST" class="inline-form">
                            <select name="status">
                                <option value="pending" <%= task.status === 'pending' ? 'selected' : '' %>>Ожидает</option>
                                <option value="in-progress" <%= task.status === 'in-progress' ? 'selected' : '' %>>В работе</option>
                                <option value="completed" <%= task.status === 'completed' ? 'selected' : '' %>>Выполнено</option>
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">Обновить</button>
                        </form>

                        <form action="/tasks/<%= task.id %>/delete" method="POST" class="inline-form">
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    </div>

                    <details class="task-edit-details">
                        <summary>Редактировать</summary>
                        <form action="/tasks/<%= task.id %>" method="POST" class="edit-form">
                            <div class="form-group">
                                <input type="text" name="title" value="<%= task.title %>" required>
                            </div>
                            <div class="form-group">
                                <textarea name="description" rows="2"><%= task.description || '' %></textarea>
                            </div>
                            <div class="form-group">
                                <input type="date" name="dueDate" value="<%= task.dueDate || '' %>">
                            </div>
                            <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                        </form>
                    </details>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>
</body>
</html>